# Homebrew bundle, installed by `yadm bootstrap` via `brew bundle --global`.
# Host class is set with: yadm config local.class work|home

# --- shell and prompt ------------------------------------------------------
brew "antidote"
brew "atuin"
brew "bash"
brew "starship"
brew "zsh"

# --- GNU userland ----------------------------------------------------------
brew "autoconf"
brew "binutils"
brew "bison"
brew "coreutils"
brew "diffutils"
brew "ed"
brew "findutils"
brew "flex"
brew "gawk"
brew "gnu-indent"
brew "gnu-sed"
brew "gnu-tar"
brew "gnu-which"
brew "gpatch"
brew "grep"
brew "gzip"
brew "m4"
brew "make"
brew "ncurses"          # bootstrap compiles tmux-256color terminfo from this
brew "perl"
brew "unzip"
brew "wdiff"

# --- core CLI --------------------------------------------------------------
brew "bat"
brew "curl"
brew "eza"
brew "file-formula"
brew "fzf"
brew "gh"
brew "git"
brew "gpg"
brew "htop"
brew "jq"
brew "lazygit"
brew "less"
brew "libressl"
brew "openssh"
brew "rsync"
brew "screen"
brew "tmux"
brew "topgrade"
brew "watch"
brew "wget"
brew "yq"

# --- editors ---------------------------------------------------------------
brew "emacs"
brew "nano"
brew "neovim"
brew "vim"

# --- languages and runtimes ------------------------------------------------
brew "go"
brew "nvm"
brew "python"
brew "uv"

# --- kubernetes and infrastructure ----------------------------------------
brew "helm"
brew "k9s"
brew "kubectl"
brew "kubectx"
brew "kustomize"
brew "opentofu"
brew "stern"

# --- casks -----------------------------------------------------------------
cask "font-inconsolata-nerd-font"
cask "ghostty"
cask "jordanbaird-ice"
cask "plexamp"
cask "podman-desktop"
cask "raycast"
cask "stats"
cask "zen"

{% if yadm.class == "work" %}
brew "argocd"
brew "postgresql"
tap "hashicorp/tap"
brew "hashicorp/tap/vault"
cask "dbeaver-community"
cask "meetingbar"
{% endif %}
{% if yadm.class == "home" %}
cask "bitwarden"
cask "lulu"
cask "winbox"
cask "zerotier-one"
{% endif %}
