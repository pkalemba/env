# ~/.config/ghostty/config
#
# Gruvbox Dark — migracja z Alacritty
# Uwaga: tmux powinien pozostać odpowiedzialny za panele, okna i sesje.

# ------------------------------------------------------------------------------
# Font
# ------------------------------------------------------------------------------

font-family = "Inconsolata Nerd Font"
font-style = Regular
font-size = 12

# Opcjonalnie: jeśli nie chcesz ligatur w kodzie / logach / tabelach TUI,
# odkomentuj:
# font-feature = -liga
# font-feature = -calt


# ------------------------------------------------------------------------------
# Kolory: Gruvbox Dark
# ------------------------------------------------------------------------------

background = #282828
foreground = #ebdbb2

# ANSI 0–7 (normal)
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984

# ANSI 8–15 (bright)
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2


# ------------------------------------------------------------------------------
# Okno
# ------------------------------------------------------------------------------

# Alacritty: opacity = 0.97
background-opacity = 0.97

# Blur działa przy background-opacity < 1; na macOS wykorzystuje mechanizmy UI
# platformy. Możesz podać true albo liczbę jako intensywność.
background-blur = true

# Przy tmuxie warto unikać automatycznego przyciemniania nieaktywnych splitów.
unfocused-split-opacity = 1.0


# ------------------------------------------------------------------------------
# Kursor
# ------------------------------------------------------------------------------

cursor-style = block
cursor-style-blink = true

# Pozostaw domyślny kolor kursora albo ustaw bardziej widoczny Gruvbox:
# cursor-color = #fabd2f
# cursor-text = #282828


# ------------------------------------------------------------------------------
# Linki i mysz
# ------------------------------------------------------------------------------

# Ghostty automatycznie rozpoznaje URL-e; na macOS przytrzymaj Cmd i kliknij,
# aby przekazać adres do domyślnej aplikacji.
link-url = true

# Zachowaj przewidywalne zachowanie mouse reporting dla tmuxa / TUI.
mouse-hide-while-typing = false
