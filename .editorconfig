# Matches the conventions already in use across this repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # two trailing spaces are a hard line break

[Makefile]
indent_style = tab

[.gitmodules]
indent_style = tab

# Shell scripts and shell rc files.
[{*.sh,*.zsh,.zshenv,.zshrc##template,bootstrap,hidutil-remap##os.Darwin}]
indent_size = 2

[*.lua]
indent_size = 2
max_line_length = 120   # kept in step with .config/astronvim/.stylua.toml
