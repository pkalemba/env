# This repo is $HOME, tracked with yadm: only files explicitly added are
# followed, so these patterns are a safety net against accidental `yadm add`.

# Generated by antidote from the .txt lists — the lists are the source.
.zsh_plugins.zsh
.zsh_plugins_pre.zsh

# Completion dump and its compiled form.
.zcompdump*

# Shell history and local state.
.zsh_history
.bash_history
.lesshst
.python_history
.node_repl_history

# Host-local, deliberately outside the repo (see .tmux.conf).
.config/tmux/proxy-command

# Caches and runtime dirs.
.cache/
.local/state/
.npm/
.terminfo/

# OS noise.
.DS_Store*
._*
Thumbs.db
ehthumbs.db

# Editor scratch.
*.swp
*.swo
*~

# Logs.
*.log
