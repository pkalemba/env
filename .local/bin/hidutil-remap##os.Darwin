#!/bin/sh
# Modifier remappings previously handled by Karabiner-Elements, now via hidutil.
# hidutil mappings reset on reboot and when a keyboard reconnects; the
# pl.p10a.hidutil-remap LaunchAgent re-runs this script at login and whenever
# one of the USB keyboards below is plugged in.
#
# HID usage values are (page << 32) + usage. Keyboard page (0x07):
#   left_option  0x7000000E2   left_command  0x7000000E3
#   right_option 0x7000000E6   right_command 0x7000000E7
#   f7 0x700000040  f8 0x700000041  f9 0x700000042
#   f10 0x700000043 f11 0x700000044 f12 0x700000045
# Consumer page (0x0C) — media keys, applied only to non-Apple keyboards
# because macOS handles the media layer natively on Apple ones:
#   scan_prev 0xC000000B6  play_pause 0xC000000CD  scan_next 0xC000000B5
#   mute 0xC000000E2  volume_down 0xC000000EA  volume_up 0xC000000E9
#
# Not portable from the old Karabiner config (hidutil can only remap key to
# key, per device):
#   - ignoring the 1452:834 Apple keyboard entirely
#   - print_screen -> cmd+shift+4 (set in System Settings > Keyboard >
#     Keyboard Shortcuts > Screenshots instead)
#   - f13/f14 -> open Safari (use a launcher hotkey, e.g. Raycast)
#   - f4/f5/f6 -> keyboard illumination

[ "$(uname -s)" = "Darwin" ] || exit 0

# Apple keyboard (1452:591): right_command -> right_option
hidutil property --matching '{"VendorID":1452,"ProductID":591}' --set '{"UserKeyMapping":[
  {"HIDKeyboardModifierMappingSrc":0x7000000E7,"HIDKeyboardModifierMappingDst":0x7000000E6}
]}' >/dev/null

# 8BitDo keyboard (11720:20992): swap left_command <-> left_option,
# f7-f12 -> media keys (Karabiner's virtual keyboard used to provide these)
hidutil property --matching '{"VendorID":11720,"ProductID":20992}' --set '{"UserKeyMapping":[
  {"HIDKeyboardModifierMappingSrc":0x7000000E3,"HIDKeyboardModifierMappingDst":0x7000000E2},
  {"HIDKeyboardModifierMappingSrc":0x7000000E2,"HIDKeyboardModifierMappingDst":0x7000000E3},
  {"HIDKeyboardModifierMappingSrc":0x700000040,"HIDKeyboardModifierMappingDst":0xC000000B6},
  {"HIDKeyboardModifierMappingSrc":0x700000041,"HIDKeyboardModifierMappingDst":0xC000000CD},
  {"HIDKeyboardModifierMappingSrc":0x700000042,"HIDKeyboardModifierMappingDst":0xC000000B5},
  {"HIDKeyboardModifierMappingSrc":0x700000043,"HIDKeyboardModifierMappingDst":0xC000000E2},
  {"HIDKeyboardModifierMappingSrc":0x700000044,"HIDKeyboardModifierMappingDst":0xC000000EA},
  {"HIDKeyboardModifierMappingSrc":0x700000045,"HIDKeyboardModifierMappingDst":0xC000000E9}
]}' >/dev/null

# Dell keyboard (16700:34053): swap left_command <-> left_option,
# f7-f12 -> media keys
hidutil property --matching '{"VendorID":16700,"ProductID":34053}' --set '{"UserKeyMapping":[
  {"HIDKeyboardModifierMappingSrc":0x7000000E3,"HIDKeyboardModifierMappingDst":0x7000000E2},
  {"HIDKeyboardModifierMappingSrc":0x7000000E2,"HIDKeyboardModifierMappingDst":0x7000000E3},
  {"HIDKeyboardModifierMappingSrc":0x700000040,"HIDKeyboardModifierMappingDst":0xC000000B6},
  {"HIDKeyboardModifierMappingSrc":0x700000041,"HIDKeyboardModifierMappingDst":0xC000000CD},
  {"HIDKeyboardModifierMappingSrc":0x700000042,"HIDKeyboardModifierMappingDst":0xC000000B5},
  {"HIDKeyboardModifierMappingSrc":0x700000043,"HIDKeyboardModifierMappingDst":0xC000000E2},
  {"HIDKeyboardModifierMappingSrc":0x700000044,"HIDKeyboardModifierMappingDst":0xC000000EA},
  {"HIDKeyboardModifierMappingSrc":0x700000045,"HIDKeyboardModifierMappingDst":0xC000000E9}
]}' >/dev/null
